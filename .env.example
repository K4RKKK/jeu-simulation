# Server — hosting/network
CIV_HOST=0.0.0.0
CIV_PORT=8787
CIV_LOG_LEVEL=warn
# Comma-separated list of HTTP/WebSocket origins allowed to call this server, in
# addition to whatever origin the server is itself reachable at (same-origin is always
# trusted automatically — see apps/server/src/net/origin.ts). Only needed for a
# cross-origin dev client (e.g. Vite on a different port) or an explicit integration.
CIV_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Absolute path to a pre-built client to serve statically (production release layout).
# Leave unset in development — Vite serves the client itself.
CIV_CLIENT_DIR=

# Server — world generation
CIV_WORLD_SEED=prehistory-01
CIV_WORLD_SIZE_CHUNKS=24
CIV_POPULATION=15

# Server — simulation loop
CIV_TICK_RATE_HZ=20
CIV_NET_RATE_HZ=10
CIV_CHUNK_BUDGET_MS=8
# Allows a client to request a full world regeneration (destructive, dev tool only).
# Defaults to true outside production, false in production — set explicitly to override.
CIV_ALLOW_REGENERATE=true

# Server — persistence
# Empty = persistence disabled (ephemeral world, nothing saved).
CIV_SAVE_DIR=.saves
CIV_SAVE_SLOT=world
# Simulation ticks between two autosaves. 0 disables autosave.
CIV_AUTOSAVE_INTERVAL_TICKS=6000
CIV_SAVE_ON_SHUTDOWN=true

# Client (read by Vite at build/dev time)
VITE_SERVER_URL=ws://localhost:8787/ws

# PostgreSQL (docker-compose only, unused by the simulation for now)
POSTGRES_USER=civ
POSTGRES_PASSWORD=civ
POSTGRES_DB=civ_sim
POSTGRES_PORT=5432
